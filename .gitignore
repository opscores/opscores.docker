# Ansible Collection - opscores.docker
# Git ignore file

# =============================================================================
# LOCAL BUILD ARTIFACTS
# =============================================================================
*.tar.gz
*.whl

# Local ansible configuration (generated by ansible-playbook)
.ansible.cfg
.ansible/

# Local vault password file
.vault_pass
.vault_password

# Local inventory files
inventory/
hosts
group_vars/
host_vars/

# Local logs
logs/
*.log

# Local molecule output
molecule/*/output/
.molecule/

# Local test output
tests/output/

# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# =============================================================================
venv/
.env
.venv/
env/
.pyenv-version

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files (macOS, Windows)
.DS_Store
Thumbs.db
.Spotlight-V100
.AppleDouble

# =============================================================================
# GITHUB ACTIONS ARTIFACTS
# =============================================================================
.github/actions-runner/
dist/
build/

# =============================================================================
# SENSITIVE DATA
# =============================================================================
*.pem
*.key
.secrets/
credentials/

# =============================================================================
# ANSIBLE COLLECTION SPECIFIC
# =============================================================================
collections/  # Installed collections (generated)
ansible-lint/*.txt  # Linting reports

# =============================================================================
# DOCKER & CONTAINERS
# =============================================================================
docker-compose.override.yml
.docker/
*.dockerfile
